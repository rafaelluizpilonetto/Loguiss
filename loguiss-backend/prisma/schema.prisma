generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id_user          Int               @id @default(autoincrement())
  nome_usuario     String
  flag_ativo       String            @default("T")
  email            String            @unique
  senha            String
  cpf              String            @unique
  senha_pdv        String
  tipo_user        String
  telefone         String
  email_verificado Boolean           @default(false)
  verificacao      verificacao_user?
}

model verificacao_user {
  expira_em      DateTime?
  id_user        Int       @unique
  id_verificacao String    @id @default(uuid())
  cod_verify     String?
  usuario        user      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
}

model unidade_medida {
  id_unidade   Int               @id @default(autoincrement())
  descrunidade String
  gramatura    String?
  is_fracionado String?
  nomenclatura String
  created_at   DateTime?         @default(now())
  flag_ativo   String?           @default("T")
  updated_at   DateTime?         @updatedAt
  produtos     produto[]
  receitas     receita_produto[]
}

model categoria {
  id_categoria       Int                 @id @default(autoincrement())
  descricao          String
  flag_ativo         String              @default("T")
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  produtos_categoria produto_categoria[]
}

model produto_categoria {
  id_produto_categoria Int       @id @default(autoincrement())
  id_produto           Int
  id_categoria         Int
  categoria            categoria @relation(fields: [id_categoria], references: [id_categoria])
  produto              produto   @relation(fields: [id_produto], references: [id_produto])

  @@unique([id_produto, id_categoria])
}

model tipo_produto {
  id_tipo_produto Int       @id @default(autoincrement())
  descricao       String
  flag_ativo      String    @default("T")
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  flag_tipo       String?
  produtos        produto[]
}

model produto {
  id_produto        Int                    @id @default(autoincrement())
  descricao         String
  id_tipo_produto   Int
  id_unidade_medida Int
  flag_ativo        String                 @default("T")
  dt_validade       DateTime?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  valor             Decimal
  estoque           estoque?
  fornecedores      fornecedor_produto[]
  movimentacoes     movimentacao_estoque[]
  tipo_produto      tipo_produto           @relation(fields: [id_tipo_produto], references: [id_tipo_produto])
  unidade_medida    unidade_medida         @relation(fields: [id_unidade_medida], references: [id_unidade])
  receita_producao  receita?
  categorias        produto_categoria[]
  receitas          receita_produto[]
  previsoes         previsao_produto[]
  alertas           alerta[]
}

model estoque {
  id_estoque    Int       @id @default(autoincrement())
  id_produto    Int       @unique
  quantidade    Decimal   @default(0)
  minimo        Decimal   @default(0)
  is_fracionado String    @default("F")
  dt_entrada    DateTime?
  prazo_saida   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  produto       produto   @relation(fields: [id_produto], references: [id_produto], onDelete: Cascade)
}

model receita {
  id_receita           Int               @id @default(autoincrement())
  descricao            String
  flag_ativo           String            @default("T")
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  margem_perda         Decimal           @default(0)
  quantidade_perdida   Decimal           @default(0)
  quantidade_produzida Decimal           @default(0)
  id_produto_producao  Int?              @unique
  produto_producao     produto?          @relation(fields: [id_produto_producao], references: [id_produto], onDelete: SetNull)
  produtos             receita_produto[]
}

model receita_produto {
  id_receita_produto Int            @id @default(autoincrement())
  id_receita         Int
  id_produto         Int
  quantidade         Decimal
  id_unidade         Int
  produto            produto        @relation(fields: [id_produto], references: [id_produto])
  receita            receita        @relation(fields: [id_receita], references: [id_receita])
  unidade_medida     unidade_medida @relation(fields: [id_unidade], references: [id_unidade])

  @@unique([id_receita, id_produto])
}

model movimentacao_estoque {
  id_movimentacao Int      @id @default(autoincrement())
  id_produto      Int
  id_cliente      Int?
  id_fornecedor   Int?
  tipo            String
  quantidade      Decimal
  valor_unitario  Decimal  @default(0) @db.Decimal(10, 2)
  valor_total     Decimal  @default(0) @db.Decimal(10, 2)
  saldo_final     Decimal
  data_movimento  DateTime @default(now())
  observacao      String?
  prazo_chegada   DateTime? 

  produto         produto    @relation(fields: [id_produto], references: [id_produto])
  cliente         cliente?   @relation(fields: [id_cliente], references: [id_cliente])
  fornecedor      fornecedor? @relation(fields: [id_fornecedor], references: [id_fornecedor])

  @@index([id_produto])
  @@index([id_cliente])
  @@index([data_movimento])
}

model endereco {
  id_endereco Int          @id @default(autoincrement())
  rua         String
  bairro      String
  numero      String
  estado      String
  cliente     cliente[]
  fornecedor  fornecedor[]
}

model fornecedor {
  id_fornecedor Int                  @id @default(autoincrement())
  cnpj          String               @unique
  nome          String
  id_endereco   Int
  email         String
  telefone      String
  flag_ativo    String? @default("T")
  endereco      endereco             @relation(fields: [id_endereco], references: [id_endereco])
  produtos      fornecedor_produto[]

  movimentacoes movimentacao_estoque[]
}

model fornecedor_produto {
  id_fornecedor_produto Int        @id @default(autoincrement())
  id_fornecedor         Int
  id_produto            Int
  quantidade            Decimal
  fornecedor            fornecedor @relation(fields: [id_fornecedor], references: [id_fornecedor])
  produto               produto    @relation(fields: [id_produto], references: [id_produto])

  @@unique([id_fornecedor, id_produto])
}

model cliente {
  id_cliente  Int       @id @default(autoincrement())
  nome        String
  cpf         String    @unique
  email       String?
  telefone    String?
  id_endereco Int?
  flag_ativo  String? @default("T")
  endereco    endereco? @relation(fields: [id_endereco], references: [id_endereco])

  movimentacoes movimentacao_estoque[]
}
model empresa {
  id_empresa        Int      @id @default(autoincrement())
  nome      String
  cidade    String?
  uf        String?
  segmento  String?
  cnpj      String   @unique
  telefone  String
  email     String   @unique
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model configuracao_ia {
  id_configuracao_ia          Int      @id @default(autoincrement())
  horizonte_dias              Int      @default(14) // tempo de previsão: quantos dias à frente a IA prevê (5, 10, 14 ou 30)
  intervalo_minutos           Int      @default(1440) // de quantos em quantos minutos a IA é consultada sozinha
  agendamento_ativo           Boolean  @default(false) // liga/desliga a consulta automática
  prazo_reposicao_padrao_dias Int      @default(3) // usado quando o produto não tem entradas com prazo_chegada
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt
}

// Uma linha por consulta feita à IA
model previsao {
  id_previsao    Int      @id @default(autoincrement())
  horizonte_dias Int
  modelo         String
  localizacao    String?
  segmento       String?
  contexto       Json? // eventos e sazonalidade que a IA pesquisou
  dados_enviados Json? // o que foi enviado para a IA (útil para defender no TCC)
  resposta_bruta Json? // o que a IA respondeu
  created_at     DateTime @default(now())

  produtos previsao_produto[]
  alertas  alerta[]

  @@index([created_at])
}

// Resultado e recomendação de compra de cada produto
model previsao_produto {
  id_previsao_produto  Int     @id @default(autoincrement())
  id_previsao          Int
  id_produto           Int
  estoque_na_data      Float
  estoque_seguro       Float
  prazo_reposicao_dias Int
  media_dia            Float
  total_previsto       Float
  confianca            Float?
  justificativa        String?
  cobertura_dias       Float? // null quando não há consumo previsto
  dias_para_comprar    Int? // null quando não há consumo previsto
  urgente              Boolean
  comprar_qtd          Float

  previsao previsao           @relation(fields: [id_previsao], references: [id_previsao], onDelete: Cascade)
  produto  produto            @relation(fields: [id_produto], references: [id_produto])
  periodos previsao_periodo[]

  @@unique([id_previsao, id_produto])
  @@index([id_produto])
}

// Série diária prevista (alimenta o gráfico)
model previsao_periodo {
  id_previsao_periodo Int      @id @default(autoincrement())
  id_previsao_produto Int
  data                DateTime @db.Date
  quantidade          Float

  previsao_produto previsao_produto @relation(fields: [id_previsao_produto], references: [id_previsao_produto], onDelete: Cascade)

  @@unique([id_previsao_produto, data])
}

// Alertas mostrados ao usuário. severidade: "urgente" | "atencao" | "informativo"
model alerta {
  id_alerta   Int      @id @default(autoincrement())
  id_previsao Int?
  id_produto  Int
  severidade  String
  titulo      String
  descricao   String
  lido        Boolean  @default(false)
  created_at  DateTime @default(now())

  previsao previsao? @relation(fields: [id_previsao], references: [id_previsao], onDelete: SetNull)
  produto  produto   @relation(fields: [id_produto], references: [id_produto])

  @@index([created_at])
}